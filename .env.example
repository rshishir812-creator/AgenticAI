# ─── LLM Provider (Groq — OpenAI-compatible) ───────────────────────────────
GROQ_API_KEY=gsk_...
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Default model routing tiers (see docs/06-production/README.md)
GROQ_MODEL_SMALL=openai/gpt-oss-20b          # fast, cheap — routing / classification
GROQ_MODEL_LARGE=openai/gpt-oss-120b         # powerful — complex reasoning, agents
GROQ_MODEL_VISION=qwen/qwen3.6-27b           # multimodal tasks

# ─── Embeddings (pgvector RAG) ───────────────────────────────────────────────
# Groq does not serve embedding models. Choose one:
# Option A — OpenAI (recommended for production):
OPENAI_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Option B — Local (no API key; runs @xenova/transformers MiniLM inside Node):
# Set EMBEDDING_PROVIDER=local to activate
EMBEDDING_PROVIDER=openai   # "openai" | "local"

# ─── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://<your-project>.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # server-side only — never expose to browser

# ─── Studio / Next.js (public — safe to expose) ──────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<your-project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
NEXT_PUBLIC_STUDIO_TITLE=Agentic AI Lab
NEXT_PUBLIC_GITHUB_URL=https://github.com/<your-username>/agentic-ai-lab

# ─── Python agents (local or Docker) ──────────────────────────────────────────
PYTHON_AGENT_URL=http://localhost:8010          # agents/langgraph-py
ADK_PY_AGENT_URL=http://localhost:8020           # agents/adk-py

# ─── Java services (local Docker) ────────────────────────────────────────────
EMBABEL_SERVICE_URL=http://localhost:8081
ADK_JAVA_SERVICE_URL=http://localhost:8082
JAVA_MCP_SERVER_URL=http://localhost:8083/mcp

# ─── MCP Servers ─────────────────────────────────────────────────────────────
# ts-open-data (Vercel): set automatically in Vercel dashboard
MCP_OPEN_DATA_URL=http://localhost:3001/mcp     # local dev

# py-research (Vercel): set automatically in Vercel dashboard
MCP_RESEARCH_URL=http://localhost:3002/mcp      # local dev

# ─── Observability ───────────────────────────────────────────────────────────
# Optional: Langfuse (self-hosted or cloud)
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

OTEL_EXPORTER=supabase   # "supabase" | "langfuse" | "console"

# ─── Agent-to-Agent (A2A) ────────────────────────────────────────────────────
A2A_REGISTRY_URL=http://localhost:4000          # local A2A service registry
