{
  "name": "agentic-ai-lab",
  "private": true,
  "version": "0.1.0",
  "description": "A production-grade Agentic AI learning lab — TypeScript, Python & Java across LangGraph, Google ADK 2.0, and Embabel",
  "packageManager": "pnpm@11.14.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "clean": "turbo clean",
    "studio": "pnpm --filter studio dev",
    "mcp:open-data": "pnpm --filter ts-open-data dev"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0",
    "prettier": "^3.3.0"
  }
}
